DEBUG=true
DATABASE_URL=postgresql+asyncpg://clinic:clinic@localhost:5432/clinic

# --- Google Calendar OAuth (Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Twilio: SMS + Voice (Phase 3 + 4) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The PUBLIC url Twilio calls, which is what it signs. Cannot be derived
# from the request at runtime -- see the note in app/core/config.py.
TWILIO_WEBHOOK_BASE_URL=http://localhost:8000

# --- SendGrid email ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# --- Google Gemini (chatbot) ---
GEMINI_API_KEY=
# Not required unless you want to pin a different model than the default
# in app/core/config.py.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Fernet keys for encrypted-at-rest columns (OAuth tokens, conversation
# text). Comma-separated, newest first -- see db/types.py for the
# prepend-new-key rotation procedure. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# --- JWT signing for staff auth. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Phase 3.5: where a chatbot escalation pages staff. Unset by default
# on purpose -- see docs/security-no-authentication.md's callout on why
# an unconfigured escalation queue is worse than no escalation path, and
# docs/phase-3.5-pre-launch-blockers.md for why this must be set before
# real patient traffic.
ESCALATION_NOTIFY_PHONE=
